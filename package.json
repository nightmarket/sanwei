{
  "name": "@nightmarket/sanwei",
  "version": "0.4.5",
  "description": "Three.js / WebGPU scene engine — managers, postprocessing, and debug tooling.",
  "keywords": [
    "three",
    "webgl",
    "webgpu",
    "3d",
    "postprocessing",
    "shaders"
  ],
  "license": "MIT",
  "author": "Chang Liu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightmarket/sanwei.git"
  },
  "homepage": "https://github.com/nightmarket/sanwei#readme",
  "bugs": {
    "url": "https://github.com/nightmarket/sanwei/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "./src/three/index.ts",
    "./src/three-webgpu/index.ts",
    "./src/webgl/CustomShaderChunks.js"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/core/constants.ts",
    "./debug": "./src/core/debugHelpers.ts",
    "./debug-runtime": {
      "types": "./src/core/Debug.ts",
      "production": "./src/core/Debug.production.ts",
      "default": "./src/core/Debug.ts"
    },
    "./three": "./src/three/index.ts",
    "./three-webgpu": "./src/three-webgpu/index.ts",
    "./physics": "./src/physics/index.ts",
    "./util/*": "./src/util/*.ts",
    "./extras/*": "./src/extras/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm run check-types",
    "publish:package": "pnpm run check-types && pnpm publish --access public"
  },
  "dependencies": {
    "detect-gpu": "^5.0.70",
    "eventemitter3": "^5.0.1",
    "normalize-wheel-es": "^1.2.0"
  },
  "peerDependencies": {
    "@dimforge/rapier3d": "^0.14.0",
    "@nightmarket/tiao": "^0.7.0",
    "glsl-noise": "^0.0.0",
    "glsl-rotate": "^2.0.1",
    "glslify-loader": "^2.0.0",
    "gsap": "^3.12.0",
    "lygia": "^1.3.3",
    "three": ">=0.160.0",
    "tone": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "@dimforge/rapier3d": {
      "optional": true
    },
    "@nightmarket/tiao": {
      "optional": true
    },
    "glsl-noise": {
      "optional": true
    },
    "glsl-rotate": {
      "optional": true
    },
    "glslify-loader": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "lygia": {
      "optional": true
    },
    "tone": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nightmarket/tiao": "^0.7.0",
    "@types/node": "^22.15.0",
    "@types/three": "^0.178.0",
    "gsap": "^3.13.0",
    "three": "^0.178.0",
    "typescript": "5.9.2"
  }
}
